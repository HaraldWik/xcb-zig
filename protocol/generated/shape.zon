            .returns = "query_version_reply",
        },
        .{
            .name = "rectangles",
            .params = .{
                .{ .name = "operation", .type = "op", .@"enum" = "so" },
                .{ .name = "destination_kind", .type = "kind", .@"enum" = "sk" },
                .{ .name = "ordering", .type = "u8", .@"enum" = "clip_ordering" },
                .{ .pad = 1 },
                .{ .name = "destination_window", .type = "window" },
                .{ .name = "x_offset", .type = "i16" },
                .{ .name = "y_offset", .type = "i16" },
                .{ .name = "rectangles", .type = "rectangle", .list = true },
            },
        },
        .{
            .name = "mask",
            .params = .{
                .{ .name = "operation", .type = "op", .@"enum" = "so" },
                .{ .name = "destination_kind", .type = "kind", .@"enum" = "sk" },
                .{ .pad = 2 },
                .{ .name = "destination_window", .type = "window" },
                .{ .name = "x_offset", .type = "i16" },
                .{ .name = "y_offset", .type = "i16" },
                .{ .name = "source_bitmap", .type = "pixmap" },
            },
        },
        .{
            .name = "combine",
            .params = .{
                .{ .name = "operation", .type = "op", .@"enum" = "so" },
                .{ .name = "destination_kind", .type = "kind", .@"enum" = "sk" },
                .{ .name = "source_kind", .type = "kind", .@"enum" = "sk" },
                .{ .pad = 1 },
                .{ .name = "destination_window", .type = "window" },
                .{ .name = "x_offset", .type = "i16" },
                .{ .name = "y_offset", .type = "i16" },
                .{ .name = "source_window", .type = "window" },
            },
        },
        .{
            .name = "offset",
            .params = .{
                .{ .name = "destination_kind", .type = "kind", .@"enum" = "sk" },
                .{ .pad = 3 },
                .{ .name = "destination_window", .type = "window" },
                .{ .name = "x_offset", .type = "i16" },
                .{ .name = "y_offset", .type = "i16" },
            },
        },
        .{
            .name = "query_extents",
            .params = .{
                .{ .name = "destination_window", .type = "window" },
            },
            .returns = "query_extents_reply",
        },
        .{
            .name = "select_input",
            .params = .{
                .{ .name = "destination_window", .type = "window" },
                .{ .name = "enable", .type = "bool" },
                .{ .pad = 3 },
            },
        },
        .{
            .name = "input_selected",
            .params = .{
                .{ .name = "destination_window", .type = "window" },
            },
            .returns = "input_selected_reply",
        },
        .{
            .name = "get_rectangles",
            .params = .{
