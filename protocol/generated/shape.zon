                .{ .name = "source_kind", .type = "kind", .@"enum" = "sk" },
                .{ .pad = 3 },
            },
            .returns = "get_rectangles_reply",
        },
    },
    .replies = .{
        .{
            .name = "query_version_reply",
            .fields = .{
                .{ .pad = 1 },
                .{ .name = "major_version", .type = "u16" },
                .{ .name = "minor_version", .type = "u16" },
            },
        },
