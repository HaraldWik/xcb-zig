            },
        },
        .{
            .name = "input_selected_reply",
            .fields = .{
                .{ .name = "enabled", .type = "bool" },
            },
        },
        .{
            .name = "get_rectangles_reply",
            .fields = .{
                .{ .name = "ordering", .type = "u8", .@"enum" = "clip_ordering" },
                .{ .name = "rectangles_len", .type = "u32" },
                .{ .pad = 20 },
                .{
                    .name = "rectangles",
                    .type = "rectangle",
                    .list = true,
