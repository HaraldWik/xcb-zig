    .typedefs = .{
        .{ .old = "u8", .new = "op" },
        .{ .old = "u8", .new = "kind" },
    },
    .enums = .{
        .{
            .name = "so",
            .fields = .{
                .{ .name = "set", .value = 0 },
                .{ .name = "union", .value = 1 },
                .{ .name = "intersect", .value = 2 },
                .{ .name = "subtract", .value = 3 },
                .{ .name = "invert", .value = 4 },
            },
        },
        .{
            .name = "sk",
            .fields = .{
                .{ .name = "bounding", .value = 0 },
                .{ .name = "clip", .value = 1 },
                .{ .name = "input", .value = 2 },
            },
        },
    },
    .bitmasks = .{},
