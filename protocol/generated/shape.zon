                .{ .name = "extents_width", .type = "u16" },
                .{ .name = "extents_height", .type = "u16" },
                .{ .name = "server_time", .type = "timestamp" },
                .{ .name = "shaped", .type = "bool" },
                .{ .pad = 11 },
            },
        },
    },
    .errors = .{},
}